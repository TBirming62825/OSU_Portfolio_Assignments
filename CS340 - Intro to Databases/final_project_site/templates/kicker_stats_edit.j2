{#
File name: kicker_stats_edit.j2

Authors: Timothy Birmingham and Cory Hungate

Description: Contains the jinja template for the kicker-stats-edit page. This page is accessed by clicking on "update"
    from a kicker stats entry on the kicker-stats page, and will autopopulate with the values for the entry selected.

Code Citations: The code in this file represents original work by the authors
#}

{% extends "main.j2" %}
{% block content %}

<h1>Kicker Stats</h1>
<div class="kicker-stats-edit">
  <p class="intro-p">Edit kicker stat below:</p>
  {# UPDATE form #}
  <form method="POST" action="">
      <table>
        <thead>
          <tr>
              <th>Name</th>
              <th>Team</th>
              <th>Opponent</th>
              <th>Extra Point Made</th>
              <th>Extra Point Attempt</th>
              <th>Field Goal Made</th>
              <th>Field Goal Attempt</th>
              <th>Action</th>
          </tr>
        </thead>
        <tbody>
          <tr>
              <td><input type="text" value="{{ j2_kicker_stats.name }}" readonly></td>
              <td><input type="text" value="{{ j2_kicker_stats.team }}" readonly></td>
              <td><input type="text" value="{{ j2_kicker_stats.opponent }}" readonly></td>
              <td><input type="number" name="extra_point_made" id="extra_point_made" class="six-char" value = "{{ j2_kicker_stats.extra_point_made }}" min=0></td>
              <td><input type="number" name="extra_point_attempt" id="extra_point_attempt" class="six-char" value = "{{ j2_kicker_stats.extra_point_attempt }}" min=0></td>
              <td><input type="number" name="field_goal_made" id="field_goal_made" class="six-char" value="{{ j2_kicker_stats.field_goal_made }}" min=0></td>
              <td><input type="number" name="field_goal_attempt" id="field_goal_attempt" class="six-char" value="{{ j2_kicker_stats.field_goal_attempt }}" min=0></td>
              <td><button type="submit">Save</button>
                <a href="/kicker-stats">Cancel</a></td>
          </tr>
        </tbody>
      </table>
      <input type="hidden" name="kicker_stat_id" value="{{ j2_kicker_stats.kicker_stats_id }}">
  </form>
</div>


{% endblock %}